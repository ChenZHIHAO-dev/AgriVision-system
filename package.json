{
  "name": "agrivision",
  "version": "1.2.1-dev.1",
  "private": true,
  "workspaces": [
    "apps/client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @agrivision/client",
    "build": "npm run build --workspace @agrivision/client",
    "build:mp": "npm run build:mp --workspace @agrivision/client",
    "typecheck": "npm run typecheck --workspace @agrivision/client",
    "build:pages": "node scripts/build-pages.mjs",
    "test:frontend": "node --test tests/frontend-state.test.mjs tests/frontend-composer.test.mjs tests/frontend-content.test.mjs",
    "format": "prettier --write \"apps/client/src/**/*.{vue,ts,css}\" \"tests/frontend-*.test.mjs\"",
    "format:check": "prettier --check \"apps/client/src/**/*.{vue,ts,css}\" \"tests/frontend-*.test.mjs\""
  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "happy-dom": "21.0.4",
    "prettier": "3.9.6"
  }
}
