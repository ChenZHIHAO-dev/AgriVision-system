        }
      }
    },
    "safearea": {
      "background": "#e9edeb",
      "backgroundDark": "#111111",
      "bottom": { "offset": "none" }
    }
  },
  "mp-weixin": {
    "appid": "touristappid",
    "setting": {
      "urlCheck": true,
      "es6": true,
      "minified": true
    },
    "usingComponents": true,
    "darkmode": true
  }
