{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "allowJs": false, "resolveJsonModule": true,
    "lib": ["ES2020", "DOM"], "types": ["@dcloudio/types", "vite/client"],
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }, "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
